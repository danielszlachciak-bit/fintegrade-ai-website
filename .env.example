# Publiczny adres projektu Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Tylko po stronie serwera. Nigdy nie dodawaj prefiksu NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Cloudflare Turnstile — wymagany przed publikacją formularzy produkcyjnych
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_SECRET_KEY

# Używane do budowy canonical URL, sitemap i metadanych
NEXT_PUBLIC_SITE_URL=https://fintegrade.ai
